<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4a32f156-7e49-4b28-9180-4bf9fe35d39a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core for SQL Server — database access -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- JSON handling — used to store the shopping cart in the session -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <!-- References to the other projects in this solution -->
  <!-- The web project depends on all three of the layers below -->
  <ItemGroup>
    <!-- Domain models, DTOs and service interfaces -->
    <ProjectReference Include="..\ElektriKalkulaator.Core\ElektriKalkulaator.Core.csproj" />
    <!-- DbContext, migrations and seed data -->
    <ProjectReference Include="..\ElektriKalkulaator.Data\ElektriKalkulaator.Data.csproj" />
    <!-- Service implementations (CalculatorServices and friends) -->
    <ProjectReference Include="..\ElektriKalkulaator.ApplicationServices\ElektriKalkulaator.ApplicationServices.csproj" />
  </ItemGroup>


  <!-- Lets ElektriKalkulaator.Tests call internal members (the image-validation helpers).
       Without this they would have to be public, which would wrongly suggest other code
       should call them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ElektriKalkulaator.Tests" />
  </ItemGroup>

</Project>
