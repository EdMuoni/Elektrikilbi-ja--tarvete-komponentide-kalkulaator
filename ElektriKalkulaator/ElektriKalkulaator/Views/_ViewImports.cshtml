@* _ViewImports.cshtml — global imports applied to EVERY view.
   Namespaces listed here do not need a using statement in individual .cshtml files. *@

@using ElektriKalkulaator
@using ElektriKalkulaator.Models
@using ElektriKalkulaator.Core.Domain
@using ElektriKalkulaator.Core.Dto
@using ElektriKalkulaator.Controllers

@* Tag helpers — these enable the asp-controller, asp-action, asp-for attributes used in the HTML. *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@* Lets any view read appsettings values, e.g. the VAT statement in VatNotice.
   The ElektriKalkulaator namespace it lives in is already imported above. *@
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
