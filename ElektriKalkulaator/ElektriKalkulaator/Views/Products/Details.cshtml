@* Toote detailvaade *@
@model ElektriKalkulaator.Core.Domain.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-secondary btn-sm">← Tagasi</a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card p-4">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="@Model.Name" class="mb-3" style="max-height:220px;border-radius:12px;object-fit:cover" />
            }

            <div class="mb-3">
                <span class="badge bg-secondary me-2">@Model.Category?.Name</span>
                <span class="text-muted-custom small">@Model.Brand</span>
            </div>

            <h2 class="text-white fw-bold mb-3">@Model.Name</h2>

            @* ── SPECIFICATION TABLE ────────────────────────────────────────────
               A table, not a grid of cards. Technical buyers compare specifications
               between products, and a two-column table is far faster to read down
               than boxes scattered across a grid — this is the pattern every serious
               components supplier uses (see docs/DESIGN_GUIDE.md §3.2).
               Rows render only when the product has that value, so a cable does not
               show an empty "rated current" row. *@
            <table class="spec-table mb-4">
                <caption class="visually-hidden">Toote tehnilised andmed</caption>
                <tbody>
                    @if (Model.RatedCurrent > 0)
                    {
                        <tr>
                            <th scope="row">Nimivool</th>
                            <td>@Model.RatedCurrent.ToString("0.##") A</td>
                        </tr>
                    }
                    @if (Model.Voltage > 0)
                    {
                        <tr>
                            <th scope="row">Nimipinge</th>
                            <td>@Model.Voltage.ToString("0.##") V</td>
                        </tr>
                    }
                    @if (Model.WireCrossSectionMm2.HasValue)
                    {
                        <tr>
                            <th scope="row">Juhtme ristlõige</th>
                            <td>@Model.WireCrossSectionMm2 mm²</td>
                        </tr>
                    }
                    <tr>
                        <th scope="row">Tootja</th>
                        <td>@Model.Brand</td>
                    </tr>
                    <tr>
                        <th scope="row">Kategooria</th>
                        <td>@Model.Category?.Name</td>
                    </tr>
                    <tr>
                        <th scope="row">Laoseis</th>
                        <td>
                            @if (Model.StockQuantity > 10)
                            {
                                <span class="text-success fw-semibold">@Model.StockQuantity tk laos</span>
                            }
                            else if (Model.StockQuantity > 0)
                            {
                                <span class="text-warning fw-semibold">Ainult @Model.StockQuantity tk laos</span>
                            }
                            else
                            {
                                <span class="text-danger fw-semibold">Otsas</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted-custom">@Model.Description</p>
            }

            <!-- Hind ja ostmine -->
            <div class="d-flex align-items-center gap-3 mt-3">
                <div class="price-tag">@Model.Price.ToString("F2") €</div>
                @if (Model.StockQuantity > 0)
                {
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn btn-amber">
                            🛒 Lisa ostukorvi
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Admin tegevused -->
    <div class="col-lg-5">
        <div class="card p-4">
            <h6 class="text-muted-custom mb-3">⚙️ Admin tegevused</h6>
            <div class="d-flex flex-column gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id"
                   class="btn btn-secondary btn-sm">✏️ Muuda</a>
                <a asp-action="Delete" asp-route-id="@Model.Id"
                   class="btn btn-danger btn-sm">🗑️ Kustuta</a>
            </div>
            <hr class="section-divider" />
            <div class="small text-muted-custom">
                <div>Lisatud: @Model.CreatedAt.ToString("dd.MM.yyyy")</div>
                <div>Muudetud: @Model.ModifiedAt.ToString("dd.MM.yyyy")</div>
            </div>
        </div>
    </div>
</div>
