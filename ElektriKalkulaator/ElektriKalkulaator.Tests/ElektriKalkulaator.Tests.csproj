<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- IsPackable=false: this project produces test results, not a NuGet package. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- xUnit is the test framework — it finds every method marked [Fact] or [Theory] and runs
       it, then reports pass/fail. Microsoft.EntityFrameworkCore.InMemory lets us swap the real
       SQL Server database for a fast, throwaway one that lives only in memory during the test
       run — no SQL Server installation needed to run these tests. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Lets every test file use [Fact], [Theory], Assert.*, etc. without an explicit
       "using Xunit;" line at the top of each file. -->
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- We test the REAL application code, not a copy of it — so this project references the
       same three layers the web project depends on. It does NOT reference the web project
       itself: tests exercise the service layer directly, the same way ShopTARge24's and
       Car_TARge24's test projects do. -->
  <ItemGroup>
    <ProjectReference Include="..\ElektriKalkulaator.Core\ElektriKalkulaator.Core.csproj" />
    <ProjectReference Include="..\ElektriKalkulaator.Data\ElektriKalkulaator.Data.csproj" />
    <ProjectReference Include="..\ElektriKalkulaator.ApplicationServices\ElektriKalkulaator.ApplicationServices.csproj" />
  </ItemGroup>

</Project>
