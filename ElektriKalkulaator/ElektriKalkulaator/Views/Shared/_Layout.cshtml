<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – ElektrikilbiKalkulaator</title>

    @* ── THEME, APPLIED BEFORE ANYTHING IS DRAWN ────────────────────────────────
       This tiny script MUST stay here: inline, in <head>, and above the
       stylesheets. It reads the visitor's saved light/dark choice and puts it on
       the <html> element before the browser paints anything.

       Move it to the bottom of the page, or into theme.js, and every page load
       flashes the default colours for a moment before switching — the effect
       usually called FOUC. It is duplicated (theme.js has the same logic) purely
       because it has to run this early, and that is worth the duplication.

       try/catch because localStorage throws in private browsing and under some
       corporate policies; a failure here must never stop the page rendering. *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('ek-theme');
                if (saved === 'light' || saved === 'dark') {
                    document.documentElement.setAttribute('data-theme', saved);
                }
            } catch (e) { /* no saved preference available; fall back to the OS setting */ }
        })();
    </script>

    <!-- Bootstrap 5 — grid and components -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* theme.css defines every colour and MUST load before site.css, which uses them. *@
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Google Fonts — Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- ================================================================
         NAVIGATSIOONIBAAR
         asp-controller / asp-action = Razor Tag Helper
         Razor genereerib automaatselt õige URL-i kontrolleri ja actioni järgi
         ================================================================ -->
    <header>
        <nav class="navbar navbar-expand-lg bg-dark-nav shadow-sm">
            <div class="container">
                <!-- Logo / brändimärk — klõps viib avalehele -->
                <a class="navbar-brand fw-bold fs-5" asp-controller="Home" asp-action="Index">
                    ⚡ ElektrikilbiKalkulaator
                </a>

                <!-- Mobiil: hamburger nupp -->
                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigatsiooni lingid -->
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                Avaleht
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Calculator" asp-action="Index">
                                Kalkulaator
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Products" asp-action="Index">
                                Tooted
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 cart-link" asp-controller="Cart" asp-action="Index">
                                Ostukorv
                            </a>
                        </li>

                        @* Light/dark switch. A <button> rather than a link because it performs an
                           action instead of navigating. theme.js fills in the icon and label, so
                           it starts empty — that also means it does nothing visible if JavaScript
                           is off, rather than showing a button that cannot work. *@
                        <li class="nav-item d-flex align-items-center">
                            <button id="themeToggle" type="button" class="theme-toggle"
                                    aria-label="Vaheta tausta värvi"></button>
                        </li>

                        @* User.Identity.IsAuthenticated is true once someone has signed in.
                           User.IsInRole("Admin") checks their role, so the admin link is only
                           shown to administrators.
                           NOTE: hiding a link is presentation, not security — the real protection
                           is [Authorize(Roles = "Admin")] on the controller. Someone typing the
                           URL directly is still blocked. *@
                        @if (User.Identity is { IsAuthenticated: true })
                        {
                            @if (User.IsInRole(ElektriKalkulaator.Core.Domain.UserRoles.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-controller="Products" asp-action="Create">
                                        Halda
                                    </a>
                                </li>
                            }
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link px-3 text-muted-custom" style="cursor:default">
                                    👤 @(User.Identity.Name)
                                </span>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                @* Logout is a POST so another site cannot sign our users out. *@
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-secondary">Logi välja</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Account" asp-action="Login">
                                    Logi sisse
                                </a>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <a class="btn btn-sm btn-amber ms-2" asp-controller="Account" asp-action="Register">
                                    Loo konto
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @*
       Main content area. Each page's own content is inserted by the RenderBody call below.

       This explanation deliberately uses a Razor comment rather than an ordinary HTML comment.
       Razor does not treat HTML comments as comments: any code written inside one still runs.
       This block previously WAS an HTML comment containing a RenderBody call, so the whole page
       body was emitted inside an unterminated comment, the main element came out empty, and the
       comment's trailing words appeared as stray text on every page.

       A Razor comment is stripped before anything inside it can run, so it is the safe place to
       mention framework calls by name.
    *@
    <main class="container py-4">
        <!-- Teadeteplokk (TempData["Success"] ja TempData["Error"]) -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                ✅ @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                ❌ @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Jalus -->
    <footer class="footer mt-auto py-4">
        <div class="container text-center">
            <p class="footer-line mb-1">
                ⚡ <strong>ElektrikilbiKalkulaator</strong> — EVS-HD 60364 standardil põhinev kalkulaator
            </p>
            <p class="footer-note mb-0">
                Tehtud Tallinnas. Arvutus on hinnang, mitte valmis projekt —
                enne paigaldust laseb pädev elektrik selle üle vaadata.
            </p>
        </div>
    </footer>

    <!-- JavaScript teegid — laaditakse lehe lõpus (kiirem laadimine) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>

    <!-- Lehekülje spetsiifilised skriptid (vorm, validatsioon jne) -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
