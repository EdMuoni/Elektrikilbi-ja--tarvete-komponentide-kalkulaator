@* Sign-in page *@
@model ElektriKalkulaator.Core.Dto.LoginDto

@{
    ViewData["Title"] = "Logi sisse";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card p-4">
            <h4 class="text-white fw-bold mb-1">🔑 Logi sisse</h4>
            <p class="text-muted-custom small mb-4">Sisesta oma e-post ja parool.</p>

            <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                @Html.AntiForgeryToken()

                @* Errors not tied to one field (e.g. "wrong email or password") appear here *@
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-post</label>
                    <input asp-for="Email" class="form-control" autocomplete="username" placeholder="nimi@näide.ee" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Parool</label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label text-muted-custom small">
                        Jäta mind meelde
                    </label>
                </div>

                <button type="submit" class="btn btn-amber w-100">Logi sisse</button>
            </form>

            <hr class="section-divider" />
            <p class="text-muted-custom small mb-0">
                Pole veel kontot? <a asp-action="Register" class="text-amber">Loo konto</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
